fn main() {
    println("Guess the number!");

    let secret_number : int = random_from::[int](1..100);
    loop {
        let guess : int = input::[int]("Please input your guess: ");

        print("You guessed: ");
        println(guess);


        let num = test();
        println(num);

        println(secret_number);
        println(guess);

        if guess < secret_number {
            println("Too small!");
            skip;
        } else if guess > secret_number {
            println("Too big!");
            skip;
        } else {
            println("You win!");
            stop;
        }
    }

    return;
}

fn test() -> int {
   return 1;
}
